# Base URL of the ClipForge FastAPI backend as seen by the browser.
# Default "/api" is proxied by the Vite dev server (and nginx in Docker).
VITE_API_URL=/api

# Dev-server proxy target for /api (prefix stripped). Not exposed to the browser.
API_PROXY_TARGET=http://localhost:8000

# Supabase auth + realtime. Leave empty for dev mode (no auth header, polling).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
