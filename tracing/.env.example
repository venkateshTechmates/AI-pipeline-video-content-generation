# ClipForge Tracing — copy to .env.local and adjust.

# API base the browser calls. Default "/api" (proxied to API_PROXY_TARGET in dev,
# to API_UPSTREAM by nginx in the Docker image).
VITE_API_URL=/api

# Dev server proxy target for /api (prefix stripped). Not exposed to the browser.
API_PROXY_TARGET=http://localhost:8000

# Where "Open in review UI" links point. Either a base URL (".../runs/<id>" is
# appended) or a template containing ":id".
VITE_REVIEW_UI_URL=http://localhost:5173

# Optional Supabase auth (same project as the review UI). When unset the app
# runs in dev mode with no sign-in and no Authorization header.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serve built-in fixture data instead of calling the API (design / demos).
# VITE_MOCK=1
