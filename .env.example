# ---- mode
# prod enforces webhook signatures + cron secret
ENV=dev
# live | fake (offline fakes, no keys)
PROVIDER_MODE=live

# ---- persistence (Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# verifies Review UI user JWTs
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=clipforge
# local store when Supabase Storage is not configured
ASSET_ROOT=data/assets
# must be reachable by fal/replicate for webhooks
PUBLIC_API_URL=http://localhost:8000

# ---- LLM (Pydantic AI)
ANTHROPIC_API_KEY=
# fallback LLM, OpenAI TTS fallback, embeddings for dedupe
OPENAI_API_KEY=
# alternative: one key for many models, e.g. LLM_MODEL=openrouter:anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
# live | fake for the LLM stages only (defaults to PROVIDER_MODE)
LLM_MODE=
LLM_MODEL=anthropic:claude-sonnet-5
LLM_FALLBACK_MODEL=openai:gpt-5
VISION_MODEL=anthropic:claude-sonnet-5

# ---- video
# Kling 3.0 (default), Seedance, Hailuo
FAL_KEY=
# random string appended to fal webhook URLs
FAL_WEBHOOK_SECRET=
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
# Veo 3.1 via Gemini API (premium tier)
GOOGLE_API_KEY=
# or Veo via Vertex AI (ADC credentials)
GOOGLE_PROJECT=
GOOGLE_LOCATION=us-central1

# ---- audio
ELEVENLABS_API_KEY=
# licensed library with manifest.json
MUSIC_LIBRARY_DIR=
EPIDEMIC_API_KEY=

# ---- render
# ffmpeg | remotion | creatomate
RENDERER=ffmpeg
# overflow renderer
CREATOMATE_API_KEY=
RENDER_OVERFLOW_THRESHOLD=20
X264_PRESET=medium

# ---- publish
# v1 publisher
UPLOAD_POST_API_KEY=
# agency multi-tenant publisher (per-brand Profile-Key credentials)
AYRSHARE_API_KEY=
PUBLISHER_WEBHOOK_SECRET=

# ---- ops / security
# static bearer token for MCP server / automation
API_TOKEN=
AUTH_REQUIRED=false
CRON_SECRET=
# run the graph worker inside the API process
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
# Slack-compatible webhook for budget / DLQ alerts
ALERT_WEBHOOK_URL=

# ---- observability
# e.g. Grafana Alloy / Tempo
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
